# Copy this file, rename the copy to .env, then fill in the values you need.
# Never commit real keys. Only SERPER_API_KEY is required for live search.

PORT=3000
SEARCH_LOCATION=Germany
CACHE_TTL_SECONDS=180
ALERT_CHECK_MINUTES=360

# Live search (Google Shopping via Serper) - required for real results
SERPER_API_KEY=

# Optional: eBay Browse API
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: Telegram support bot and price alerts
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Reviews + moderation (see DEPLOYMENT_RU.md).
# Leave unset locally to keep reviews read-only; set all of them to accept reviews.
# In production REVIEWS_DATA_DIR must be an absolute path and REVIEWS_SECRET >= 32 chars.
REVIEWS_ADMIN_PASSWORD=
REVIEWS_SECRET=
REVIEWS_PERSISTENT_STORAGE=false
REVIEWS_DATA_DIR=
PUBLIC_SITE_URL=

# Set only when running behind a trusted reverse proxy that appends the client IP.
TRUST_PROXY_HOPS=0
